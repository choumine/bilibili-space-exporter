{
  "manifest_version": 3,
  "name": "B站视频批量提取器",
  "version": "1.2.0",
  "description": "自动提取B站用户空间全部视频信息（标题、BV号、播放量等），导出为 CSV 文件",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://space.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
